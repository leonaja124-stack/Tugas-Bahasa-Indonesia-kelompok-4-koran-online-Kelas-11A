                    fontFamily: {
                        serifHeader: ['"Playfair Display"', 'Georgia', 'serif'],
                        serifBody: ['"Merriweather"', 'serif'],
                        sans: ['"Inter"', 'sans-serif']
                    }
                }
            }
        }
