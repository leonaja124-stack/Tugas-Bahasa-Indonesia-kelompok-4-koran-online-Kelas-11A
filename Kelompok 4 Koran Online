                        <span class="text-xs bg-red-600 text-white px-2 py-0.5 rounded font-sans uppercase">Audio</span>
                    </h3>
                    <p class="font-sans text-xs text-gray-600 dark:text-gray-400 mb-3">
                        Sesi wawancara langsung oleh Syafika (11A) dengan Boas Sineri.
                    </p>
                    
                    <div class="bg-black/5 dark:bg-black/30 p-3 rounded text-center">
                        <p class="text-xs font-sans text-gray-500 italic">File audio telah disesuaikan.</p>
                    </div>
                </div>

                <!-- Tim Akustik School Roster -->
                <div class="border border-black p-4 dark:border-gray-600 bg-white dark:bg-gray-800">
                    <h3 class="font-serifHeader text-lg font-bold uppercase border-b-2 border-black dark:border-white pb-1 mb-3 text-center">
                        Susunan Anggota Tim Juara
                    </h3>
                    <ul class="font-sans text-sm divide-y divide-gray-200 dark:divide-gray-700">
                        <li class="py-2 flex justify-between items-center">
                            <span class="font-semibold">Daniel Krey</span>
                            <span class="text-xs bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded">Kelas 12B</span>
                        </li>
                        <li class="py-2 flex justify-between items-center">
                            <span class="font-semibold">Marcelino Marey</span>
                            <span class="text-xs bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded">Kelas 12A</span>
                        </li>
                        <li class="py-2 flex justify-between items-center">
                            <span class="font-semibold">Jolei Sinai</span>
                            <span class="text-xs bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded">Kelas 12M</span>
                        </li>
                        <li class="py-2 flex justify-between items-center">
                            <span class="font-semibold">Ones Bab</span>
                            <span class="text-xs bg-gray-200 dark:bg-gray-700 px-2 py-1 rounded">Kelas 12E</span>
                        </li>
                        <li class="py-2 flex justify-between items-center bg-yellow-100 dark:bg-yellow-900/40 p-1 rounded">
                            <span class="font-bold text-red-900 dark:text-yellow-300">Adrianus Boas Sineri</span>
                            <span class="text-xs bg-yellow-200 dark:bg-yellow-800 px-2 py-1 rounded font-bold">Kelas 12M</span>
                        </li>
                    </ul>
                </div>

                <!-- Info Tugas Siswa Box -->
                <div class="border-2 border-dashed border-gray-400 p-4 font-sans text-xs bg-gray-50 dark:bg-gray-800">
                    <h4 class="font-bold text-sm uppercase mb-2 border-b pb-1">Keterangan Tugas Sekolah</h4>
                    <p class="mb-1"><strong>Mata Pelajaran:</strong> Bahasa Indonesia</p>
                    <p class="mb-1"><strong>Kelas:</strong> 11A</p>
                    <p class="mb-1"><strong>Materi:</strong> Teks Berita & Wawancara Tokoh</p>
                    <p class="mb-1"><strong>Pewawancara:</strong> Syafika</p>
                    <p><strong>Narasumber:</strong> Adrianus Boas Sineri</p>
                </div>

                <!-- Guru Assessment Box -->
                <div class="bg-blue-50 dark:bg-gray-800 p-4 border border-blue-200 dark:border-gray-600 rounded">
                    <h4 class="font-serifHeader font-bold text-sm text-blue-900 dark:text-blue-300 mb-2 uppercase tracking-wide">
                        <i class="fa-solid fa-pen-to-square mr-1"></i> Kolom Catatan Guru
                    </h4>
                    <textarea class="w-full text-xs p-2 border rounded dark:bg-gray-900 dark:text-white" rows="3" placeholder="Tuliskan nilai dan umpan balik untuk tugas Syafika (11A)..."></textarea>
                    <button onclick="alert('Catatan berhasil disimpan!')" class="mt-2 w-full bg-blue-800 hover:bg-blue-700 text-white font-sans text-xs py-1.5 rounded transition">
                        Simpan Evaluasi
                    </button>
                </div>

            </aside>

        </main>

        <!-- Footer -->
        <footer class="mt-10 border-t-4 border-black pt-4 pb-6 text-center font-sans text-xs text-gray-600 dark:text-gray-400">
            <p class="font-bold text-sm mb-1 text-black dark:text-white">GEMA PELAJAR DIGITAL - KORAN ONLINE SEKOLAH</p>
