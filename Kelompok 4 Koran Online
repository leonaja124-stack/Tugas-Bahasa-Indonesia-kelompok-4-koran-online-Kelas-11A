        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        newspaper: {
                            bg: '#fcfbf7',
                            card: '#f4f1ea',
                            border: '#222222',
                            text: '#111111',
                            muted: '#555555'
