        </footer>

    </div>

    <!-- Theme Switcher Script -->
    <script>
        function setTheme(theme) {
            const body = document.getElementById('body');
            body.className = "font-serifBody transition-colors duration-300 min-h-screen flex flex-col justify-between ";
            
            if (theme === 'modern') {
                body.classList.add('bg-[#fcfbf7]', 'text-[#111111]');
            } else if (theme === 'sepia') {
                body.classList.add('bg-[#f4ebd0]', 'text-[#3d2314]');
            } else if (theme === 'dark') {
                body.classList.add('bg-gray-900', 'text-gray-100', 'dark');
            }
        }
    </script>
</body>
